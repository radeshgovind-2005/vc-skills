#!/bin/sh
# vc: block commits on main, scan staged changes for secrets, run lint.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

branch=$(git symbolic-ref --short -q HEAD)
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  case "$branch" in
    main|master)
      echo "pre-commit: do not commit on $branch. Create a branch first (type/short-name)." >&2
      exit 1 ;;
  esac
fi

patterns='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|xox[baprs]-[A-Za-z0-9-]{10,}|(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -Eq "$patterns"; then
  echo "pre-commit: possible secret in staged changes. Remove it, then rotate it." >&2
  exit 1
fi

sh .githooks/run-checks.sh lint
