#!/bin/sh
# vc: enforce a Conventional Commit title. Installed by the vc-setup skill.
msg_file="$1"
first=$(sed -n '1p' "$msg_file")

case "$first" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  got:      $first" >&2
  echo "  expected: type(scope): description" >&2
  echo "  types:    feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  example:  fix(cart): stop double discount on coupon reuse" >&2
  exit 1
}

printf '%s\n' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ]' \
  || fail "title is not a Conventional Commit"
[ "${#first}" -le 72 ] || fail "title is longer than 72 characters"
case "$first" in *.) fail "title ends with a period" ;; esac
exit 0
