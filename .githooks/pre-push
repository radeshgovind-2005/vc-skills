#!/bin/sh
# vc: block direct pushes to main, then run tests.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked. Open a PR instead." >&2
      exit 1 ;;
  esac
done
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
sh .githooks/run-checks.sh test
